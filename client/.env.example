# ---------------------------------------------------------------------------
# Optional — jeebhar.config.json drives the real build. Copy to client/.env.local. Vite inlines VITE_* vars into the bundle at build
# time, so NEVER put a secret here — the admin token is typed in at runtime.
# ---------------------------------------------------------------------------

# Base URL of the API, including the /api prefix.
VITE_API_BASE_URL=/api

# Abort a request after this many milliseconds.
VITE_REQUEST_TIMEOUT_MS=15000

# Where `npm run dev` proxies /api and /uploads (the PHP dev server, npm run dev:api).
VITE_DEV_API_TARGET=http://localhost:5000
