# ---------------------------------------------------------------------------
# Copy to server/.env and fill in real values. NEVER commit server/.env.
# Placeholders only in this file — it is tracked by git.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/jeebhar

# Shared secret required by PUT /api/content (the /admin editor).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-with-a-long-random-string

# SMTP for contact-form notifications. Leave blank to disable email: submissions
# are still stored and the notification is skipped.
#
# Do NOT leave a placeholder host here. "smtp.example.com" does not exist, so the
# form appears to work while nothing is ever delivered — the app treats a
# placeholder host as "not configured" for exactly that reason.
#
# Gmail:  SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and SMTP_PASS must be a
#         16-character app password (https://myaccount.google.com/apppasswords),
#         not your normal account password.
#
# Check it with:  npm run mail:test
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=

# Request throttling.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_CONTACT_MAX=5
