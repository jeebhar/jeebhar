# ---------------------------------------------------------------------------
# Copy to .env in the repository root — read by docker compose only.
# Placeholders here; the real .env is gitignored.
# ---------------------------------------------------------------------------

# Port nginx is published on.
HTTP_PORT=8080

# Container images. Leave unset to build from source locally. A CD deploy
# rewrites these to the ghcr.io images it just published.
# SERVER_IMAGE=ghcr.io/<owner>/<repo>/server:1.0.0
# CLIENT_IMAGE=ghcr.io/<owner>/<repo>/client:1.0.0

# MongoDB credentials. The container is not published to the host.
MONGO_USER=jeebhar
MONGO_PASSWORD=change-me-to-a-strong-password
MONGO_DB=jeebhar

# Required by PUT /api/content.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-with-a-long-random-string

# Browser origin allowed to call the API.
CLIENT_ORIGIN=http://localhost:8080

LOG_LEVEL=info

# Optional SMTP. Leave blank to store enquiries without sending notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=
