# Jeebhar — public_html/.htaccess
# Generated by `npm run build:bluehost` from deploy/public_html.htaccess.
# Serves the same site on jeebhar.com, jeebhar.de and jeebhar.in.

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Always HTTPS (Bluehost's free AutoSSL covers every alias domain).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# {{WWW_REDIRECT}}

# API → api/index.php (api/.htaccess takes over from here).
RewriteRule ^api(/.*)?$ - [L]

# Single-page app: anything that is not a real file is the React app.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Caching: hashed build assets forever, the HTML never (so deploys show at once).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
