  "services": [
    {
      "_id": "service-01",
      "title": {
        "en": "Brand Management",
        "de": "Markenmanagement"
      },
      "shortDescription": {
        "en": "Build a memorable identity customers trust.",
        "de": "Eine unverwechselbare Identität, der Gäste vertrauen."
      },
      "longDescription": {
        "en": "We shape your brand voice, visual identity and communication strategy so every post, reel and campaign reinforces the same positioning.",
        "de": "Wir entwickeln Markenstimme, visuelle Identität und Kommunikationsstrategie, damit jeder Post, jedes Reel und jede Kampagne dieselbe Positionierung stärkt."
      }
    },
    {
      "_id": "service-02",
      "title": {
        "en": "Social Media Management",
        "de": "Social-Media-Management"
      },
      "shortDescription": {
        "en": "Consistent publishing and growth-focused execution.",
        "de": "Regelmäßige Veröffentlichungen mit Fokus auf Wachstum."
      },
      "longDescription": {
        "en": "From content calendars to community engagement and analytics, we run your channels end to end with a growth mindset.",
        "de": "Von Redaktionsplänen über Community-Management bis zur Auswertung betreuen wir Ihre Kanäle komplett – mit klarem Blick auf Wachstum."
      }
    },
    {
      "_id": "service-03",
      "title": {
        "en": "Content Creation",
        "de": "Content-Produktion"
      },
      "shortDescription": {
        "en": "High-converting visuals and narratives.",
        "de": "Bilder und Geschichten, die überzeugen."
      },
      "longDescription": {
        "en": "We produce scroll-stopping photo, video and copy crafted specifically for restaurants and the people who love eating at them.",
        "de": "Wir produzieren Fotos, Videos und Texte, die zum Anhalten bringen – gemacht für Restaurants und die Menschen, die dort gerne essen."
      }
    },
    {
      "_id": "service-04",
      "title": {
        "en": "Social Media Advertising",
        "de": "Social-Media-Werbung"
      },
      "shortDescription": {
        "en": "Paid campaigns built for ROI.",
        "de": "Bezahlte Kampagnen mit messbarem ROI."
      },
      "longDescription": {
        "en": "We design and optimise ad funnels for awareness, bookings, online orders and repeat customers with data-backed targeting.",
        "de": "Wir planen und optimieren Anzeigen-Funnels für Reichweite, Reservierungen, Online-Bestellungen und Stammgäste – mit datenbasiertem Targeting."
      }
    }
  ],
